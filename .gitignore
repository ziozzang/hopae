# Public deployment templates stay tracked; operator copies and state do not.
/deploy/.env
/deploy/*.env
!/deploy/.env.example
/deploy/state/
/deploy/secrets/
/deploy/overrides/
/deploy/*.local.yaml
/deploy/*.local.yml
