# Names only; replace every change-me with a private random value and keep the
# real file (hopae.env) out of version control and out of the image.

# Shared caller key: the gateway sends it in x-hopae-gateway-key. Put the SAME
# value in the gateway's environment as HANGANG_HOPAE_KEY.
HOPAE_GATEWAY_KEY=change-me

# Google OAuth client secret (the client_id is in hopae.local.json).
HOPAE_PROVIDER_GOOGLE_CLIENT_SECRET=change-me

# Optional, only during caller-key rotation (gateway.caller_key_next_env).
# HOPAE_GATEWAY_KEY_NEXT=change-me

# Image tag used by compose.yaml, convention <version>-<shortsha>.
# HOPAE_TAG=0.1.0-abc1234
