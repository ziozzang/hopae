{
  "listen": {
    "portal": "127.0.0.1:0",
    "gateway": "127.0.0.1:0"
  },
  "state_dir": "state",
  "portal": {
    "public_url": "http://auth.example.test"
  },
  "gateway": {
    "kind": "hangang",
    "caller_key_env": "HOPAE_TEST_GATEWAY_KEY",
    "verify_budget_ms": 400
  },
  "session": {
    "idle": "24h",
    "absolute": "30d"
  },
  "cookie": {
    "name": "hopae",
    "secure": false
  },
  "apps": [
    {
      "app_id": "app",
      "display_name": "app",
      "hosts": [
        "app.example.test"
      ],
      "ports": [
        443
      ],
      "session": {
        "idle": "12h",
        "absolute": "7d"
      },
      "binding": {
        "ip": "strict",
        "ua": "off",
        "on_mismatch": "terminate_session"
      },
      "on_authz_change": "refresh",
      "verify_cache_seconds": 0
    },
    {
      "app_id": "default",
      "display_name": "default"
    }
  ],
  "providers": [
    {
      "provider_id": "mock",
      "kind": "oidc",
      "display_name": "Mock",
      "client_id": "hopae-test",
      "client_secret_env": "HOPAE_TEST_MOCK_SECRET",
      "issuer": "http://127.0.0.1:0",
      "allow_private_endpoints": true,
      "scope": "openid email profile",
      "auto_link": false
    }
  ],
  "linking": {
    "on_conflict": "link_required"
  },
  "txn": {
    "max_rows": 1000,
    "per_ip_per_minute": 30
  },
  "handoff": {
    "per_ip_failures_per_minute": 10,
    "max_recoveries": 3
  },
  "events": {
    "retention_days": 90,
    "max_rows": 1000000,
    "prune_every": 1000,
    "max_pending_per_sink": 10000,
    "delivery_terminal_retention_days": 7
  },
  "trusted_proxies": [
    "127.0.0.1/32"
  ],
  "log": {
    "level": "debug"
  }
}
